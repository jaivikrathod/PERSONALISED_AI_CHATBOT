# --- PostgreSQL -------------------------------------------------------------
# Used by config/settings.py -> DATABASES["default"].
DB_NAME=temp_chatbot
DB_USER=postgres
DB_PASSWORD=9844@Baby
DB_HOST=localhost
DB_PORT=5432

# --- Chatbot / LLM (Google Gemini) ------------------------------------------
# API key from https://aistudio.google.com/apikey — required for chat answers.
GEMINI_API_KEY=test_key
# Model used to answer from the retrieved FAQ context.
GEMINI_MODEL=gemini-2.5-flash
# Below this cosine score the best FAQ match is treated as "no reliable answer".
CHAT_CONFIDENCE_THRESHOLD=0.40
